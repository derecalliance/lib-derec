<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>DeRec.Library</PackageId>
    <Authors>DeRec Alliance</Authors>
    <Company>DeRec Alliance</Company>
    <Description>.NET bindings for derec-library, the Rust SDK for the DeRec protocol.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/derecalliance/lib-derec</RepositoryUrl>
    <PackageProjectUrl>https://derec.org</PackageProjectUrl>
    <PackageTags>derec recovery secret-sharing sdk dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
      <None Include="runtimes/osx-arm64/native/libderec_library.dylib"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native/"
          Condition="Exists('runtimes/osx-arm64/native/libderec_library.dylib')" />

      <None Include="runtimes/osx-x64/native/libderec_library.dylib"
          Pack="true"
          PackagePath="runtimes/osx-x64/native/"
          Condition="Exists('runtimes/osx-x64/native/libderec_library.dylib')" />

      <None Include="runtimes/linux-x64/native/libderec_library.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/"
          Condition="Exists('runtimes/linux-x64/native/libderec_library.so')" />

      <None Include="runtimes/linux-arm64/native/libderec_library.so"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native/"
          Condition="Exists('runtimes/linux-arm64/native/libderec_library.so')" />

      <!-- Windows is not produced by the release build yet. This slot is a
           no-op until a `derec_library.dll` is staged at
           runtimes/win-x64/native/, at which point `dotnet pack` includes it
           automatically. See the README's "Platform support" section. -->
      <None Include="runtimes/win-x64/native/derec_library.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/"
          Condition="Exists('runtimes/win-x64/native/derec_library.dll')" />
  </ItemGroup>

  <!--
    Copy the host-RID native library to the consumer's bin/ on plain `dotnet build`
    (ProjectReference consumers don't get NuGet's RID-resolution).
    NuGet consumers pick the right RID from `runtimes/<RID>/native/` instead and
    don't see these Content items.

    The `_IsPacking != true` guard is required: during `dotnet pack` the host RID's
    dylib is also a `<None Pack="true">` item above. Without the guard the two items
    collide on the same file and the `Pack="false"` Content item wins, silently
    dropping the host RID from the produced package.
  -->
  <ItemGroup Condition="'$(_IsPacking)' != 'true' AND '$([MSBuild]::IsOSPlatform(OSX))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">
      <Content Include="runtimes/osx-arm64/native/libderec_library.dylib"
          Condition="Exists('runtimes/osx-arm64/native/libderec_library.dylib')"
          Link="libderec_library.dylib"
          Pack="false"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(_IsPacking)' != 'true' AND '$([MSBuild]::IsOSPlatform(OSX))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
      <Content Include="runtimes/osx-x64/native/libderec_library.dylib"
          Condition="Exists('runtimes/osx-x64/native/libderec_library.dylib')"
          Link="libderec_library.dylib"
          Pack="false"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(_IsPacking)' != 'true' AND '$([MSBuild]::IsOSPlatform(Linux))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">
      <Content Include="runtimes/linux-arm64/native/libderec_library.so"
          Condition="Exists('runtimes/linux-arm64/native/libderec_library.so')"
          Link="libderec_library.so"
          Pack="false"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(_IsPacking)' != 'true' AND '$([MSBuild]::IsOSPlatform(Linux))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
      <Content Include="runtimes/linux-x64/native/libderec_library.so"
          Condition="Exists('runtimes/linux-x64/native/libderec_library.so')"
          Link="libderec_library.so"
          Pack="false"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(_IsPacking)' != 'true' AND '$([MSBuild]::IsOSPlatform(Windows))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
      <Content Include="runtimes/win-x64/native/derec_library.dll"
          Condition="Exists('runtimes/win-x64/native/derec_library.dll')"
          Link="derec_library.dll"
          Pack="false"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
      <Protobuf Include="../../../protobufs/protobufs/*.proto"
          GrpcServices="None"
          ProtoRoot="../../../protobufs/protobufs"
      />
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="Google.Protobuf" Version="3.32.0" />
      <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
