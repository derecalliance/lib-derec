# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

node_modules/
# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

.DS_Store

.claude/

bin/
obj/
runtimes/

# Superpowers SDD scratch
.superpowers/

# wasm-pack's default output directory. `make nodejs` / `make web` build into
# library/target/pkg-*, but a bare `wasm-pack build` drops this here and it is
# never an input to anything.
/library/pkg/

# React Native native artifacts and compiled output, all produced by
# scripts/prepare-react-native-package.sh.
/packages/react-native/ios/DeRecFFI.xcframework/
/packages/react-native/android/src/main/jniLibs/
/packages/react-native/android/.cxx/
/packages/react-native/android/build/
/packages/react-native/lib/
/packages/react-native/dist/

# Compiled smoke-test binaries. `go build ./...` in smoke-tests/go drops an
# executable named after the directory; it is a build output, never an input.
/smoke-tests/go/go

/packages/dotnet/DeRec.Library/schema/
