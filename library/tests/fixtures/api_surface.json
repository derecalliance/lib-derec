  "documented_api": {
    "$note": "Holds the prose to the source. A consumer reads CHANGELOG.md and deprecation notes while their build is broken, so a name that does not resolve costs them a search through five bindings to conclude the document was wrong. Both defects this guards were shipped and found by hand: the changelog described `Error::NoCommonTransport` as current behaviour after it had been renamed, and the deprecation wave named two removal versions because the notes were written weeks apart.",
    "retired_error_variants": [
      {
        "enum": "Error",
        "variant": "NoCommonTransport",
        "replaced_by": "NoUsableEndpoint",
        "why": "Renamed to `NoUsableEndpoint { offered }` in 0.0.3. Explaining the rename is the one legitimate reason to write a variant that no longer exists, so `replaced_by` must appear in the same paragraph — an entry that names the old spelling and not the new one is describing it as current, which is the defect this guards."
      },
      {
        "enum": "TransportValidationError",
        "variant": "UnknownProtocol",
        "replaced_by": "UnsupportedProtocol",
        "why": "Deprecated in 0.0.3 and removed in 0.0.6. The 0.0.3 entry that deprecated it names the replacement alongside it."
      },
      {
        "enum": "Error",
        "variant": "ConflictingPlaintextOptIn",
        "replaced_by": "unsafe_connection",
        "why": "Existed only to reconcile `unsafe_http` with `unsafe_connection`; removed in 0.0.6 with `unsafe_http`. The entry that introduced it names the flag that remains."
      }
    ],
    "$deprecation_horizon_note": "The open deprecation wave: `since`, `removed_at` and any `exceptions`. `null` means no wave is open, and then no `#[deprecated]` may exist in the library — a deprecation is only ever introduced together with the horizon it is removed at.",
    "deprecation_horizon": null
  }
