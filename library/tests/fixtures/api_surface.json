  "sdk_helpers": [
    {
      "what": "filter predicate",
      "why": "a store whose backing cannot express ChannelFilter as a query needs to apply it in memory without re-deriving the empty-means-unrestricted and exclude-after-ids rules",
      "dotnet": "ChannelFilter.Matches",
      "go": "HelperFilter.Matches",
      "ts": "channelFilterMatches"
    },
    {
      "what": "advertised endpoints reader",
      "why": "every message that advertises where its sender can be reached carries the same supportedTransports list, and reading it through one helper keeps that rule in one place per binding",
      "dotnet": "ContactMessage.AdvertisedEndpoints",
      "go": "AdvertisedEndpoints",
      "ts": "advertisedEndpoints"
    },
    {
      "what": "sequential failover transport",
      "why": "the send contract has four rules and none is about dialing; written by hand per binding it is untested code reaching identical behaviour, and the shortest thing that compiles is endpoints[0], which forfeits failover silently",
      "dotnet": "SequentialFailover",
      "go": "SequentialFailover",
      "ts": "sequentialFailover"
    },
    {
      "what": "replica id generator",
      "why": "a replica id must be random and never 0; minting it in the core means no binding can produce one the core refuses",
      "dotnet": "DeRecProtocolBuilder.GenerateReplicaId",
      "go": "GenerateReplicaID",
      "ts": "generate_replica_id",
      "ffi": "derec_generate_replica_id",
      "wasm": "generate_replica_id"
    },
    {
      "what": "protocol version",
      "why": "audit trails and logs record which protocol version a build speaks; it comes from the core so no binding can report one it does not write",
      "dotnet": "ProtocolVersion.Current",
      "go": "CurrentProtocolVersion",
      "ts": "protocol_version",
      "ffi": "derec_protocol_version",
      "wasm": "protocol_version"
    },
    {
      "what": "single endpoint transport",
      "why": "taking endpoints[0] inline reads as finished; naming the type records that failover was considered and declined, which is a claim a reviewer can disagree with",
      "dotnet": "SingleEndpointTransport",
      "go": "SingleEndpointTransport",
      "ts": "singleEndpointTransport"
    }
  ],
